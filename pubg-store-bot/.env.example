# توكن البوت من BotFather
BOT_TOKEN=123456:REPLACE_ME

# PostgreSQL
DATABASE_URL=postgresql://pubg:pubg@127.0.0.1:5432/pubg_store?schema=public

# Redis (جلسات + طوابير + مهلات)
REDIS_URL=redis://127.0.0.1:6379

# المتجر الافتراضي
# معرّف القناة مثل -1001234567890
DEFAULT_CHANNEL_ID=-1001234567890
# آيدي مالك القناة الرقمي في تلغرام
OWNER_TELEGRAM_ID=123456789
# يوزر المالك بدون @ — يظهر في الإعلان فقط
OWNER_USERNAME=channel_owner
# مالك المنصة (لوحة /admin وتأكيد الاشتراكات). الافتراضي = OWNER_TELEGRAM_ID
SUPER_ADMIN_TELEGRAM_ID=
# مفتاح تشفير توكنات البوتات: 64 محرف hex. إذا فاضي يُشتق من BOT_TOKEN محليًا فقط
TOKEN_ENCRYPTION_KEY=

# التجربة والاشتراك
# محليًا للاختبار: TRIAL_HOURS=0.01 ≈ 36 ثانية
TRIAL_HOURS=48
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_PRICE_SAR=99
SUBSCRIPTION_REMINDER_HOURS=12
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=حوّل 99 ريال لحساب مالك المنصة، ثم أرسل صورة الإيصال من زر تجديد الاشتراك.

# رسوم الإعلان بالريال لكل قناة. 0 = مجاني وينشر فورًا بدون إيصال
LISTING_FEE=0
# AUTO = نشر فوري | APPROVAL = بموافقة المالك
PUBLISH_MODE=AUTO

# مهلة رد البائع على استفسار المشتري بالدقائق، ثم تذكير، ثم مهلة إضافية
INQUIRY_TIMEOUT_MINUTES=15
INQUIRY_GRACE_MINUTES=5

# حد يومي لإعلانات كل بائع (0 = بدون حد) وrate limit للخاص
SELLER_DAILY_LISTING_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=40

# طبقة الذكاء الاصطناعي — اترك المفتاح فارغًا لاستخدام المنطق الاحتياطي بدون LLM
# LLM_PROVIDER: openai | grok | anthropic | noop
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
XAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=3
LLM_TIMEOUT_MS=20000
LLM_INPUT_PRICE_PER_MILLION=2.5
LLM_OUTPUT_PRICE_PER_MILLION=10

# لوحة المالك (ويب) — المسار /dashboard
WEB_PORT=3780
WEB_PUBLIC_URL=http://127.0.0.1:3780
# في الإنتاج يُضبط تلقائيًا إلى https://getsarh.tech
# يوزر البوت بدون @ لودجت دخول تلقرام وزر التجربة في الصفحة التعريفية
BOT_USERNAME=
# توكن دخول اللوحة: افتح /dashboard/login أو الصق الرمز في النموذج
DASHBOARD_TOKEN=
# يوزر التواصل في تذييل الصفحة التعريفية (مع أو بدون @)
LANDING_CONTACT_TELEGRAM=

# الإنتاج على getsarh.tech (docker-compose.prod.yml يضبط العناوين)
DOMAIN=getsarh.tech
WEBHOOK_URL=
WEBHOOK_SECRET=
POSTGRES_PASSWORD=pubg

LOG_LEVEL=info
NODE_ENV=development

# ── Physical-products shop (CJdropshipping) ──
# API key from CJ → My CJ → Authorization → API (format CJUserNum@api@xxxx). Never commit the real key.
CJ_API_KEY=
# 3 = create CJ order only (pay it in CJ dashboard), 2 = auto-pay from CJ balance
CJ_PAY_TYPE=3
CJ_DEFAULT_LOGISTIC=CJPacket Liquid Line
# Persist CJ access token (getAccessToken is rate-limited); e.g. /app/data/cj-token.json
CJ_TOKEN_CACHE_FILE=
SHOP_USD_TO_SAR=3.75
SHOP_DEFAULT_MARKUP_PERCENT=120
SHOP_TRACKING_SYNC_MINUTES=30

# Extra Telegram chat ids (comma-separated) for shop order alerts, in addition to SUPER_ADMIN_TELEGRAM_ID
SHOP_ADMIN_CHAT_IDS=
